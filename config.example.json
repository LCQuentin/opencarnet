{
  "_comment": "Neutral example config (no personal paths). Copy to ~/.config/opencarnet/config.json and adapt.",
  "root": "./out",
  "language": "en",
  "link_style": "wikilink",
  "review_dir": "to-review",
  "index": {
    "_comment": "Extra folder to scan for deduplication. Your destination folders are ALWAYS scanned; leave empty to scan only them (never scans all of root).",
    "scan_dir": ""
  },
  "default_theme": "general",
  "ai_themes": [
    "tech"
  ],
  "themes": {
    "general": "general",
    "tech": "tech",
    "business": "business",
    "culture": "culture",
    "lifestyle": "lifestyle"
  },
  "frontmatter": {
    "_comment": "Order = property order in the note. Placeholders: {any analysis field}, {source_url}, {today}, {tags}, {categorie}. \"fields\": {} => no frontmatter.",
    "fields": {
      "tags": {
        "value": "{tags}",
        "style": "block"
      },
      "category": "{categorie}",
      "themes": "{themes}",
      "status": "to-review",
      "source": "{source_url}",
      "created": "{today}"
    },
    "by_family": {},
    "base_tags": [
      "imported"
    ],
    "default_categorie": "note"
  },
  "custom_fields": {},
  "formats": "formats/en.json",
  "geocoding": {
    "_comment": "Optional GPS lookup for places via OpenStreetMap Nominatim (network call, max 1 request/s, cached). Set a User-Agent that identifies you.",
    "enabled": false,
    "user_agent": ""
  },
  "routes": {
    "prompt": {
      "family": "prompt",
      "categorie": "prompt",
      "folder": "prompts",
      "tags": [
        "prompt"
      ]
    },
    "skill": {
      "family": "prompt",
      "categorie": "prompt",
      "folder": "prompts",
      "tags": [
        "prompt",
        "skill"
      ]
    },
    "modele-ia": {
      "family": "resource",
      "categorie": "note",
      "folder": "tech",
      "tags": [
        "ai"
      ]
    },
    "outil-service": {
      "family": "resource",
      "categorie": "note",
      "folder_if_ai": "tech",
      "tags_if_ai": [
        "ai"
      ]
    },
    "actualite": {
      "family": "resource",
      "categorie": "note",
      "folder_if_ai": "tech",
      "tags_if_ai": [
        "ai"
      ]
    },
    "astuce": {
      "family": "resource",
      "categorie": "note"
    },
    "inspiration-design": {
      "family": "resource",
      "categorie": "note"
    },
    "reference": {
      "family": "resource",
      "categorie": "note"
    }
  }
}
