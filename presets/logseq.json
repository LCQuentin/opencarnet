{
  "_comment": "Logseq — a graph's 'pages/' folder, wikilinks, organisation by properties and tags.",
  "_tool_label": { "en": "Logseq", "fr": "Logseq" },
  "_root_default": "~/Documents/logseq",
  "_review_default": "pages",
  "link_style": "wikilink",
  "index": { "scan_dir": "pages" },
  "default_theme": "general",
  "ai_themes": ["tech"],
  "themes": {
    "general": "pages",
    "tech": "pages",
    "business": "pages",
    "culture": "pages",
    "lifestyle": "pages"
  },
  "frontmatter": {
    "fields": {
      "tags": { "value": "{tags}", "style": "block" },
      "category": "{categorie}",
      "themes": "{themes}",
      "status": "to-review",
      "source": "{source_url}",
      "created": "{today}"
    },
    "by_family": {},
    "base_tags": ["imported"],
    "default_categorie": "note"
  },
  "custom_fields": {},
  "formats": "formats/{LANG}.json",
  "geocoding": { "enabled": false, "user_agent": "" },
  "routes": {
    "prompt": {
      "family": "prompt",
      "categorie": "prompt",
      "folder": "pages",
      "tags": ["prompt"]
    },
    "skill": {
      "family": "prompt",
      "categorie": "prompt",
      "folder": "pages",
      "tags": ["prompt", "skill"]
    },
    "modele-ia": {
      "family": "resource",
      "categorie": "note",
      "folder": "pages",
      "tags": ["ai"]
    },
    "outil-service": {
      "family": "resource",
      "categorie": "note",
      "folder": "pages",
      "tags_if_ai": ["ai"]
    },
    "actualite": {
      "family": "resource",
      "categorie": "note",
      "folder": "pages",
      "tags_if_ai": ["ai"]
    },
    "astuce": {
      "family": "resource",
      "categorie": "note"
    },
    "inspiration-design": {
      "family": "resource",
      "categorie": "note"
    },
    "reference": {
      "family": "resource",
      "categorie": "note"
    }
  }
}
